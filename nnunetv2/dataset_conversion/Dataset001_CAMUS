from pathlib import Path
import shutil

from nnunetv2.dataset_conversion.generate_dataset_json import generate_dataset_json

CAMUS_SOURCE = Path(
    "/Users/duyenquang/Cardiotoxicity/CAMUS_public/database_nifti"
)

NNUNET_RAW = Path(
    "/Users/duyenquang/nnUNet_data/nnUNet_raw"
)

DATASET_NAME = "Dataset001_CAMUS"


output_folder = NNUNET_RAW / DATASET_NAME

imagesTr = output_folder / "imagesTr"
labelsTr = output_folder / "labelsTr"

imagesTr.mkdir(parents=True, exist_ok=True)
labelsTr.mkdir(parents=True, exist_ok=True)

num_training_cases = 0

views = ["2CH", "4CH"]
phases = ["ED", "ES"]

for patient_folder in sorted(CAMUS_SOURCE.iterdir()):

    if not patient_folder.is_dir():
        continue

    patient_id = patient_folder.name

    print(f"Processing {patient_id}")

    for view in views:
        for phase in phases:

            image_name = f"{patient_id}_{view}_{phase}.nii.gz"
            label_name = f"{patient_id}_{view}_{phase}_gt.nii.gz"

            image_path = patient_folder / image_name
            label_path = patient_folder / label_name

            if not image_path.exists():
                print(f"Missing image: {image_path}")
                continue

            if not label_path.exists():
                print(f"Missing label: {label_path}")
                continue

            case_id = f"{patient_id}_{view}_{phase}"

            output_image = imagesTr / f"{case_id}_0000.nii.gz"
            output_label = labelsTr / f"{case_id}.nii.gz"

            shutil.copy(image_path, output_image)
            shutil.copy(label_path, output_label)

            num_training_cases += 1

print()
print(f"Finished copying {num_training_cases} training cases.")

generate_dataset_json(
    output_folder,
    channel_names={
        "0": "ultrasound",
    },
    labels={
        "background": 0,
        "LV": 1,
        "Myocardium": 2,
        "LeftAtrium": 3,
    },
    num_training_cases=num_training_cases,
    file_ending=".nii.gz",
    dataset_name="CAMUS",
    reference="CAMUS Challenge",
    release="1.0",
    description="Cardiac Acquisitions for Multi-structure Ultrasound Segmentation"
)

print("dataset.json created successfully.")